# URL pública do projeto Supabase.
SUPABASE_URL=

# Chave pública/anon. Nunca use a chave de serviço neste campo.
SUPABASE_KEY=

# Somente backend e scripts administrativos. Nunca expor no navegador.
SUPABASE_SERVICE_KEY=

# Use production somente com autenticação habilitada e segredos rotacionados.
PLANOS_ENV=development
PLANOS_AUTH_ENABLED=false
