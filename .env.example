# URL pública do projeto Supabase.
SUPABASE_URL=

# Chave pública atual, no formato sb_publishable_...
SUPABASE_KEY=

# Chave atual do backend, no formato sb_secret_...
# O nome da variável é preservado por compatibilidade interna.
# Nunca expor no navegador.
SUPABASE_SERVICE_KEY=

# Use production somente com autenticação habilitada e segredos rotacionados.
PLANOS_ENV=development
PLANOS_AUTH_ENABLED=false
